# mini-agent configuration (12factor: environment over hardcode)
# Copy to .env or export in your shell / service definition.

# --- Required -----------------------------------------------------------
# OpenAI-compatible chat-completions endpoint (no trailing /chat/completions)
MINI_AGENT_BASE_URL=http://spark-1:8888/v1

# Model name as the endpoint reports it (GET {BASE_URL}/models)
MINI_AGENT_MODEL=GLM-5.3-Flash-EXL3

# --- Loop limits (0 disables a limit, mini-swe-agent style) --------------
# Max model/tool loop steps. 0 = run until the model stops calling tools.
MINI_AGENT_MAX_STEPS=0

# Seconds per bash tool call (stateless subprocess)
MINI_AGENT_TIMEOUT=120

# Seconds per LM HTTP request (curl --max-time)
MINI_AGENT_HTTP_TIMEOUT=300

# --- Tool-result truncation ---------------------------------------------
# Tool results longer than MAX_OUTPUT chars keep TRUNC_HEAD head + TRUNC_TAIL
# tail, with a "...N chars elided..." marker (mini-swe observation style).
MINI_AGENT_MAX_OUTPUT=20000
MINI_AGENT_TRUNC_HEAD=10000
MINI_AGENT_TRUNC_TAIL=10000

# --- Thinking/reasoning --------------------------------------------------
# off | enabled (default budget 16384) | enabled:<budget> | raw JSON snippet
MINI_AGENT_THINKING=enabled

# --- System prompt --------------------------------------------------------
# Path resolved against the working directory at invocation
MINI_AGENT_SYSTEM_MD=SYSTEM.md

# --- Behavior -------------------------------------------------------------
# Set to run main() at load time (used by run.lisp wrappers / scripts);
# leave unset when loading the file interactively to call (mini-agent:main).
#MINI_AGENT_AUTORUN=1
